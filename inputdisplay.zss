
#===============================================================================
# Functions
#===============================================================================
[Function TrainingRecovery(pn)]
# Life recovery
if player($pn),moveType = H || player($pn),dizzy {
	mapSet{map: "_iksys_trainingLifeTimer"; value: 0; redirectid: player($pn),id}
} else if player($pn),map(_iksys_trainingLifeTimer) >= 60 {
	lifeSet{value: player($pn),lifeMax; redirectid: player($pn),id}
	redLifeSet{value: player($pn),lifeMax; redirectid: player($pn),id}
	mapSet{map: "_iksys_trainingLifeTimer"; value: 0; redirectid: player($pn),id}
} else {
	mapAdd{map: "_iksys_trainingLifeTimer"; value: 1; redirectid: player($pn),id}
}
# Power recovery
if player($pn),ctrl = 0 {
	mapSet{map: "_iksys_trainingPowerTimer"; value: 0; redirectid: player($pn),id}
} else if player($pn),map(_iksys_trainingPowerTimer) >= 60 {
	powerSet{value: player($pn),powerMax; redirectid: player($pn),id}
	mapSet{map: "_iksys_trainingPowerTimer"; value: 0; redirectid: player($pn),id}
} else {
	mapAdd{map: "_iksys_trainingPowerTimer"; value: 1; redirectid: player($pn),id}
}

#===============================================================================
# Input Display Helper state
#===============================================================================
[StateDef 11290900; anim:-2;]

notHitBy{value: SCA}

	# scales the explods according to localcoord 
let f = 1/const240p(1);

let screen1 = screenwidth/320.0;
let screen2 = ceil(screenwidth);

#;==========================
#;==========================
#;;>>@Config.Display_Input>>
#;; (v.180728) display input v47 ; (操作入力表示)
#;; (* the result seems NOT always corect. especially when the player has been placed in a custom state)
#;; (* 結果がいつも正しいとは限りません、特にステートが奪われたとき)

##---
	##;sys::ki_arrow_key_pressed
if root,command="holdfwd"   && !(map(_iksys_trainingInputDisplay1)&16384) || root,command="holdback" && !(map(_iksys_trainingInputDisplay1)&32768) || root,command="holdup" && !(map(_iksys_trainingInputDisplay1)&65536) || root,command="holddown" && !(map(_iksys_trainingInputDisplay1)&131072)
	#;---
|| (map(_iksys_trainingInputDisplay1)&16384) && ((root,command!="holddown" && map(_iksys_trainingInputDisplay1)&131072) || (root,command!="holdup" && map(_iksys_trainingInputDisplay1)&65536) || (root,command!="holdback" && map(_iksys_trainingInputDisplay1)&32768))
	#;---
|| (map(_iksys_trainingInputDisplay1)&32768) && ((root,command!="holddown" && map(_iksys_trainingInputDisplay1)&131072) || (root,command!="holdup" && map(_iksys_trainingInputDisplay1)&65536) || (root,command!="holdfwd" && map(_iksys_trainingInputDisplay1)&16384))
	#;---
|| (map(_iksys_trainingInputDisplay1)&65536) && ((root,command!="holddown" && map(_iksys_trainingInputDisplay1)&131072) || (root,command!="holdfwd" && map(_iksys_trainingInputDisplay1)&16384) || (root,command!="holdback" && map(_iksys_trainingInputDisplay1)&32768))
	#;---
|| (map(_iksys_trainingInputDisplay1)&131072) && ((root,command!="holdup" && map(_iksys_trainingInputDisplay1)&65536) || (root,command!="holdfwd" && map(_iksys_trainingInputDisplay1)&16384) || (root,command!="holdback" && map(_iksys_trainingInputDisplay1)&32768)) {
	explod{
	id:112230100 +( (map(_iksys_trainingInputDisplay2):=ceil(map(_iksys_trainingInputDisplay2))+30101) %100); ##;v47 {AABBCC: AA:Timer / BB:Pos_X++ / CC:Pos_Y++}
	anim:IND 230150 +((root,command="holdfwd")-(root,command="holdback"&&root,command!="holdfwd"))*20*(root,facing) +((root,command="holddown"&&root,command!="holdup")-(root,command="holdup"))*5;
	ontop:1;
	postype:left;
	bindtime:-1;
	ignorehitpause:1;
	supermovetime:-1;
	pausemovetime:-1;
	scale:$f*0.25*$screen1,$f*0.25*$screen1;
	pos:$screen2*(teamside=2)+floor(13*$screen1)*ifelse(teamside=1,1,-1) , floor((50+(ceil(map(_iksys_trainingInputDisplay2))%100)*8)*$screen1);
	ownpal:1
		}
	}

	#;;sys::ki_arrow_key_hold
if (root,command="holdfwd")||(root,command="holdback")||(root,command="holdup")||(root,command="holddown") {
	explod{
	id:112230199;
	anim:IND 230150 +((root,command="holdfwd")-(root,command="holdback"))*20*(root,facing) +((root,command="holddown")-(root,command="holdup"))*5;
	ontop:1;
	postype:left;
	ownpal:1;
	bindtime:-1;
	ignorehitpause:1;
	supermovetime:-1;
	pausemovetime:-1;
	scale:$f*0.25*$screen1,$f*0.25*$screen1;
	pos:$screen2*(teamside=2)+floor(5*$screen1)*ifelse(teamside=1,1,-1) , floor((50+(ceil(map(_iksys_trainingInputDisplay2))%100)*8)*$screen1);
	removetime:1;
	trans:addalpha;
	alpha:128,128
		}
	}
	
	#;--- button_all
	#;sys::ki_key_simultaneously ;同時押し判定
if (root,command="x") && !(map(_iksys_trainingInputDisplay1)&262144) || (root,command="y") && !(map(_iksys_trainingInputDisplay1)&524288) || (root,command="z") && !(map(_iksys_trainingInputDisplay1)&1048576) || (root,command="a") && !(map(_iksys_trainingInputDisplay1)&2097152) || (root,command="b") && !(map(_iksys_trainingInputDisplay1)&4194304) || (root,command="c") && !(map(_iksys_trainingInputDisplay1)&8388608) {
	map(_iksys_trainingInputDisplay2):=ceil(map(_iksys_trainingInputDisplay2))+ ifelse(ceil(map(_iksys_trainingInputDisplay2))>99,100,1) + 10000; ## ;;30000  ;;(tickspersecond%60)*500 ;; 
	}
	#;--- button
	#;sys::ki_key_x
if (root,command="x") && !(map(_iksys_trainingInputDisplay1)&262144) {
	explod{
	id:112230100 +(ceil(map(_iksys_trainingInputDisplay2))%100);
	anim:IND 230203;
	ontop:1;
	postype:left;
	bindtime:-1;
	ignorehitpause:1;
	supermovetime:-1;
	pausemovetime:-1;
	scale:$f*0.28*$screen1,$f*0.28*$screen1;
	pos:$screen2*(teamside=2)+floor((5+(map(_iksys_trainingInputDisplay2):=ceil(map(_iksys_trainingInputDisplay2))+100)/100%100*8)*$screen1)*ifelse(teamside=1,1,-1) , floor((50+(ceil(map(_iksys_trainingInputDisplay2))%100)*8)*$screen1);
	ownpal:1
		}
	}
	#;sys::ki_key_y
if (root,command="y") && !(map(_iksys_trainingInputDisplay1)&524288) {
	explod{
	id:112230100 +(ceil(map(_iksys_trainingInputDisplay2))%100);
	anim:IND 230204;
	ontop:1;
	postype:left;
	bindtime:-1;
	ignorehitpause:1;
	supermovetime:-1;
	pausemovetime:-1;
	scale:$f*0.28*$screen1,$f*0.28*$screen1;
	pos:$screen2*(teamside=2)+floor((5+(map(_iksys_trainingInputDisplay2):=ceil(map(_iksys_trainingInputDisplay2))+100)/100%100*8)*$screen1)*ifelse(teamside=1,1,-1) , floor((50+(ceil(map(_iksys_trainingInputDisplay2))%100)*8)*$screen1);
	ownpal:1
		}
	}
	#;sys::ki_key_z
if (root,command="z") && !(map(_iksys_trainingInputDisplay1)&1048576) {
	explod{
	id:112230100 +(ceil(map(_iksys_trainingInputDisplay2))%100);
	anim:IND 230205;
	ontop:1;
	postype:left;
	bindtime:-1;
	ignorehitpause:1;
	supermovetime:-1;
	pausemovetime:-1;
	scale:$f*0.28*$screen1,$f*0.28*$screen1;
	pos:$screen2*(teamside=2)+floor((5+(map(_iksys_trainingInputDisplay2):=ceil(map(_iksys_trainingInputDisplay2))+100)/100%100*8)*$screen1)*ifelse(teamside=1,1,-1) , floor((50+(ceil(map(_iksys_trainingInputDisplay2))%100)*8)*$screen1);
	ownpal:1
		}
	}
	#;sys::ki_key_a
if (root,command="a") && !(map(_iksys_trainingInputDisplay1)&2097152) {
	explod{
	id:112230100 +(ceil(map(_iksys_trainingInputDisplay2))%100);
	anim:IND 230200;
	ontop:1;
	postype:left;
	bindtime:-1;
	ignorehitpause:1;
	supermovetime:-1;
	pausemovetime:-1;
	scale:$f*0.28*$screen1,$f*0.28*$screen1;
	pos:$screen2*(teamside=2)+floor((5+(map(_iksys_trainingInputDisplay2):=ceil(map(_iksys_trainingInputDisplay2))+100)/100%100*8)*$screen1)*ifelse(teamside=1,1,-1) , floor((50+(ceil(map(_iksys_trainingInputDisplay2))%100)*8)*$screen1);
	ownpal:1
		}
	}
	#;sys::ki_key_b
if (root,command="b") && !(map(_iksys_trainingInputDisplay1)&4194304) {
	explod{
	id:112230100 +(ceil(map(_iksys_trainingInputDisplay2))%100);
	anim:IND 230201;
	ontop:1;
	postype:left;
	bindtime:-1;
	ignorehitpause:1;
	supermovetime:-1;
	pausemovetime:-1;
	scale:$f*0.28*$screen1,$f*0.28*$screen1;
	pos:$screen2*(teamside=2)+floor((5+(map(_iksys_trainingInputDisplay2):=ceil(map(_iksys_trainingInputDisplay2))+100)/100%100*8)*$screen1)*ifelse(teamside=1,1,-1) , floor((50+(ceil(map(_iksys_trainingInputDisplay2))%100)*8)*$screen1);
	ownpal:1
		}
	}
	#;sys::ki_key_c
if (root,command="c") && !(map(_iksys_trainingInputDisplay1)&8388608) {
	explod{
	id:112230100 +(ceil(map(_iksys_trainingInputDisplay2))%100);
	anim:IND 230202;
	ontop:1;
	postype:left;
	bindtime:-1;
	ignorehitpause:1;
	supermovetime:-1;
	pausemovetime:-1;
	scale:$f*0.28*$screen1,$f*0.28*$screen1;
	pos:$screen2*(teamside=2)+floor((5+(map(_iksys_trainingInputDisplay2):=ceil(map(_iksys_trainingInputDisplay2))+100)/100%100*8)*$screen1)*ifelse(teamside=1,1,-1) , floor((50+(ceil(map(_iksys_trainingInputDisplay2))%100)*8)*$screen1);
	ownpal:1
		}
	}
	#;--- Curent_Pos_Y_UnderLine
if numexplod(112230100+(ceil(map(_iksys_trainingInputDisplay2))%100)) && ceil(map(_iksys_trainingInputDisplay2))>9999 {
	explod{
	id:112230000+(ceil(map(_iksys_trainingInputDisplay2))%100);
	anim:IND 200111+(teamside);
	ontop:1;
	postype:left;
	bindtime:-1;
	ignorehitpause:1;
	supermovetime:-1;
	pausemovetime:-1;
	pos:$screen2*(teamside=2), floor((56+(ceil(map(_iksys_trainingInputDisplay2))%100)*8)*$screen1);
	scale:ifelse(teamside=1,3,-3)*$f*$screen1,1*$f*$screen1;
	sprpriority:-1;
	removetime:1;
	ownpal:1
		}
	}
##---

##;;--- ---
#;sys::ki_icon_index/pos_reset
##; Pos_Y_ReSet
if (ceil(map(_iksys_trainingInputDisplay2))%100>12) || (ceil(map(_iksys_trainingInputDisplay2)) && !(numexplod(112230100)||numexplod(112230101)||numexplod(112230102))) { map(_iksys_trainingInputDisplay2):=0;}
##; Pos_X_ReSet / Timer_Count_Down
if (ceil(map(_iksys_trainingInputDisplay2))>99) { map(_iksys_trainingInputDisplay2):= (ceil(map(_iksys_trainingInputDisplay2))%100) +ceil(map(_iksys_trainingInputDisplay2))/10000*10000 -(ceil(map(_iksys_trainingInputDisplay2))>9999)*10000;}
#;sys::ki_icon_index_cls
if numexplod(112230101 +(ceil(map(_iksys_trainingInputDisplay2))%100)) {removeexplod{id:112230101 +(ceil(map(_iksys_trainingInputDisplay2))%100)}}

#;==========================
#;==========================
#;; Key Pressed Switch / ボタン開閉
#;; v08: bit flag (15th-24th,26th)
#;;---
#;sys::ki_switch00
#;;---
if (map(_iksys_trainingInputDisplay1)&16384) && (root,command!="holdfwd") {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)^16384); }
if (root,command="holdfwd") && !(map(_iksys_trainingInputDisplay1)&16384) {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)|16384); }
#;;---
if (map(_iksys_trainingInputDisplay1)&32768) && (root,command!="holdback") {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)^32768); }
if (root,command="holdback") && !(map(_iksys_trainingInputDisplay1)&32768) {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)|32768); }
#;;---
if (map(_iksys_trainingInputDisplay1)&65536) && (root,command!="holdup") {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)^65536); }
if (root,command="holdup") && !(map(_iksys_trainingInputDisplay1)&65536) {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)|65536); }
#;;---
if (map(_iksys_trainingInputDisplay1)&131072) && (root,command!="holddown") {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)^131072); }
if (root,command="holddown") && !(map(_iksys_trainingInputDisplay1)&131072) {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)|131072); }
#;;---
if (map(_iksys_trainingInputDisplay1)&262144) && (root,command!="x") {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)^262144); }
if (root,command="x") && !(map(_iksys_trainingInputDisplay1)&262144) {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)|262144); }
#;;---
if (map(_iksys_trainingInputDisplay1)&524288) && (root,command!="y") {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)^524288); }
if (root,command="y") && !(map(_iksys_trainingInputDisplay1)&524288) {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)|524288); }
#;;---
if (map(_iksys_trainingInputDisplay1)&1048576) && (root,command!="z") {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)^1048576); }
if (root,command="z") && !(map(_iksys_trainingInputDisplay1)&1048576) {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)|1048576); }
#;;---
if (map(_iksys_trainingInputDisplay1)&2097152) && (root,command!="a") {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)^2097152); }
if (root,command="a") && !(map(_iksys_trainingInputDisplay1)&2097152) {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)|2097152); }
#;;---
if (map(_iksys_trainingInputDisplay1)&4194304) && (root,command!="b") {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)^4194304); }
if (root,command="b") && !(map(_iksys_trainingInputDisplay1)&4194304) {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)|4194304); }
#;;---
if (map(_iksys_trainingInputDisplay1)&8388608) && (root,command!="c") {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)^8388608); }
if (root,command="c") && !(map(_iksys_trainingInputDisplay1)&8388608) {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)|8388608); }
##;;---
##;;--- display flag
if (map(_iksys_trainingInputDisplay1)&33554432) {map(_iksys_trainingInputDisplay1):=(map(_iksys_trainingInputDisplay1)^33554432); }

#===============================================================================
# Global states (not halted by Pause/SuperPause, no helper limitations)
#===============================================================================
[StateDef -4]

	# Spawns the input display helper 
ignorehitpause if gamemode = "training" && !ishelper && !numhelper(11290900) && teamleader {
	helper{
		id:11290900;
		name:"Input Display Helper";
		stateno:11290900;
		helpertype:normal;
		size.air.front:1911115; ##; <<-version
		size.height:0; ## 1;; <<-powerbar off mode
		supermovetime:88888;
		pausemovetime:88888;
		pos:0,88888;
		ownpal:1 
		}
	}
	
ignoreHitPause if gameMode != "training" || isHelper || teamSide != 2 {
	# Do nothing, not training more or statedef executed by helper or not P2
} else ignoreHitPause if roundState = 0 {
	# Round start reset
	powerSet{value: player(1),powerMax; redirectid: player(1),id}
	powerSet{value: player(2),powerMax; redirectid: player(2),id}
	map(_iksys_trainingLifeTimer) := 0;
	map(_iksys_trainingPowerTimer) := 0;
	map(_iksys_trainingDirection) := 0;
	map(_iksys_trainingAirJumpNum) := 0;
} else ignoreHitPause if roundState = 2 {
	assertSpecial{flag: globalNoKo}
	# Life and Power recovery
	for i = 1; player(1),numPartner + 1; 1 {
		call TrainingRecovery($i * 2 - 1);
	}
	for i = 1; player(2),numPartner + 1; 1 {
		call TrainingRecovery($i * 2);
	}
	# Dummy Control: Cooperative
	if aiLevel = 0 && map(_iksys_trainingDummyControl) = 0 {
		# Guard mode: Random
		if map(_iksys_trainingGuardMode) = 3 {
			if random < 500 {
				assertSpecial{flag: autoGuard}
			}
		# Guard mode: All
		} else if map(_iksys_trainingGuardMode) = 2 {
			assertSpecial{flag: autoGuard}
		# Guard mode: Auto
		} else if map(_iksys_trainingGuardMode) = 1 {
			if moveType = H || stateNo = const(StateDownedGetHit_gettingUp) {
				map(_iksys_trainingAutoGuardTimer) := 15;
			} else {
				map(_iksys_trainingAutoGuardTimer) := (map(_iksys_trainingAutoGuardTimer) - 1);
			}
			if map(_iksys_trainingAutoGuardTimer) > 0 {
				assertSpecial{flag: autoGuard}
			}
		}
		# Fall Recovery
		if map(_iksys_trainingFallRecovery) {
			if stateNo != [const(StateAirGetHit_fallRecoveryOnGroundStillFalling), const(StateAirGetHit_fallRecoveryInAir)] {
				if moveType = H && stateType = A && hitFall && !getHitVar(isbound) && (pos y || vel y) {
					if (map(_iksys_trainingFallRecovery) = 1 && pos y >= const(movement.air.gethit.groundrecover.ground.threshold)) # Ground recovery
					|| (map(_iksys_trainingFallRecovery) = 2 && pos y < const(movement.air.gethit.groundrecover.ground.threshold)) # Air recovery
					|| (map(_iksys_trainingFallRecovery) = 3 && random < 100) { # Random recovery
						if gametime % 2 {
							assertInput{flag: x; flag2: y; flag3: z} # Ideally one would specifically force the character's "recovery" command
						} else {
							assertInput{flag: a; flag2: b; flag3: c}
						}
						# Random direction
						if map(_iksys_trainingFallRecovery) = 3 {
							if random < 333 {
								assertInput{flag: L}
							} else if random < 500 {
								assertInput{flag: R}
							}
							if random < 333 {
								assertInput{flag: U}
							} else if random < 500 {
								assertInput{flag: D}
							}
						}
					}
				}
			}
		}
		# Distance
		let dir = 0;
		if map(_iksys_trainingDistance) != 0 {
			# Close
			if map(_iksys_trainingDistance) = 1 && p2BodyDist x > const240p(10) {
				let dir = 1;
				map(_iksys_trainingDirection) := 1;
			# Medium
			} else if map(_iksys_trainingDistance) = 2 {
				if p2BodyDist x > const240p(130) {
					let dir = 1;
					map(_iksys_trainingDirection) := 1;
				} else if p2BodyDist x < const240p(80) && backEdgeBodyDist > const240p(10) {
					let dir = -1;
					map(_iksys_trainingDirection) := -1;
				}
			# Far
			} else if map(_iksys_trainingDistance) = 3 {
				if p2BodyDist x < const240p(260) && backEdgeBodyDist > const240p(10) {
					let dir = -1;
					map(_iksys_trainingDirection) := -1;
				}
			}
		}
		if map(_iksys_trainingDirection) != 0 {
			# if adjusting position is no longer needed
			if $dir = 0 {
				# maintain assertion only if dummy and nearest P1 are moving in the same direction
				if vel x * p2,vel x >= 0 || backEdgeBodyDist = 0 || p2,backEdgeBodyDist = 0 {
					map(_iksys_trainingDirection) := 0;
				}
			}
			# if dummy should move forward and player is not trying to move dummy back
			if map(_iksys_trainingDirection) = 1 && command != "holdback" {
				if facing = 1 {
					assertInput{flag: R}
				} else {
					assertInput{flag: L}
				}
			# if dummy should move backward and player is not trying to move dummy forward
			} else if map(_iksys_trainingDirection) = -1 && command != "holdfwd" {
				if facing = 1 {
					assertInput{flag: L}
				} else {
					assertInput{flag: R}
				}
			}
		} else {
			# Dummy mode
			switch map(_iksys_trainingDummyMode) {
			# Crouch
			case 1:
				assertInput{flag: D}
			# Jump
			case 2:
				assertInput{flag: U}
			# W Jump
			case 3:
				if vel y >= 0 {
					assertInput{flag: U}
				}
			default:
				# Do nothing
			}
			# Button jam
			if map(_iksys_trainingButtonJam) > 0 {
				if map(_iksys_trainingButtonJamDelay) > 0 {
					mapAdd{map: "_iksys_trainingButtonJamDelay"; value: -1}
				} else {
					map(_iksys_trainingButtonJamDelay) := 11;
					switch map(_iksys_trainingButtonJam) {
					case 1:
						assertInput{flag: a}
					case 2:
						assertInput{flag: b}
					case 3:
						assertInput{flag: c}
					case 4:
						assertInput{flag: x}
					case 5:
						assertInput{flag: y}
					case 6:
						assertInput{flag: z}
					case 7:
						assertInput{flag: s}
					case 8:
						assertInput{flag: d}
					case 9:
						assertInput{flag: w}
					default:
						map(_iksys_trainingButtonJamDelay) := 0;
					}
				}
			}
		}
	}
}